{
  "name": "data-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/core-node && tsc -p packages/join-receipt --noEmit",
    "accuracy": "tsx fixtures/join-receipt/accuracy.ts",
    "accuracy:real": "tsx fixtures/join-receipt/real-accuracy.ts",
    "fixtures": "tsx fixtures/join-receipt/generate.ts",
    "dev": "npm run dev -w join-receipt"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
